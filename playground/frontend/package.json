{
	"name": "playground",
	"version": "0.1.0",
	"description": "A web-app with objective of providing the employees a way of simulating and visualising the warehouse",
	"main": "index.js",
	"license": "MIT",
	"dependencies": {
		"camera-controls": "^1.33.1",
		"react": "^17.0.2",
		"react-dom": "^17.0.2",
		"react-helmet": "^6.1.0",
		"three": "^0.134.0"
	},
	"devDependencies": {
		"@babel/core": "^7.16.0",
		"@babel/plugin-transform-runtime": "^7.16.4",
		"@babel/preset-env": "^7.16.4",
		"@babel/preset-react": "^7.16.0",
		"@babel/preset-typescript": "^7.16.0",
		"@emotion/core": "^11.0.0",
		"@emotion/react": "^11.7.0",
		"@emotion/styled": "^11.6.0",
		"@mui/icons-material": "^5.2.1",
		"@mui/material": "^5.2.3",
		"@types/jest": "^27.0.3",
		"@types/material-ui": "^0.21.12",
		"@types/node": "^16.11.9",
		"@types/react": "^17.0.36",
		"@types/react-dom": "^17.0.11",
		"@types/react-helmet": "^6.1.4",
		"@types/three": "^0.134.0",
		"@typescript-eslint/eslint-plugin": "^5.4.0",
		"@typescript-eslint/parser": "^5.4.0",
		"babel-eslint": "^10.1.0",
		"babel-loader": "^8.2.3",
		"css-loader": "^6.5.1",
		"eslint": "^8.3.0",
		"eslint-config-airbnb-typescript": "^16.0.0",
		"eslint-config-prettier": "^8.3.0",
		"eslint-plugin-react": "^7.27.1",
		"eslint-webpack-plugin": "^3.1.1",
		"html-webpack-plugin": "^5.5.0",
		"prettier": "^2.4.1",
		"style-loader": "^3.3.1",
		"ts-loader": "^9.2.6",
		"ts-node": "^10.4.0",
		"typescript": "^4.5.2",
		"webpack": "^5.64.2",
		"webpack-cli": "^4.9.1",
		"webpack-dev-server": "^4.5.0"
	},
	"scripts": {
		"start": "webpack-dev-server --mode=development",
		"build": "webpack --mode=production",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx .",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,html,json,yml}\"",
		"check-format": "prettier --check \"**/*.{js,jsx,ts,tsx,css,html,json,yml}\""
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"babel": {
		"presets": [
			"@babel/preset-env",
			"@babel/preset-react",
			"@babel/preset-typescript"
		],
		"plugins": [
			[
				"@babel/plugin-transform-runtime",
				{
					"regenerator": true
				}
			]
		]
	}
}
